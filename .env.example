# QE Connect settings. Copy this file to .env (in the same folder as start.bat) and change what you need.
# Every setting is optional; without a .env file QE Connect runs on this computer only, at http://localhost:8000.
# Use forward slashes in paths, even on Windows (for example C:/QEConnect/data).

# ---- Where it listens ----
# 127.0.0.1 = this computer only. 0.0.0.0 = other computers on the network can connect (open the port in the firewall).
QEC_HOST=127.0.0.1
QEC_PORT=8000
# The address people use to reach QE Connect. Survey links in emails use it unless "Survey link address" is set
# on the Email delivery page. Example: https://qe-connect.example.local
QEC_PUBLIC_URL=

# ---- HTTPS ----
# Turn on HTTPS in QE Connect itself: PEM certificate (with chain) and private key files.
# Leave empty when a reverse proxy (IIS, nginx) provides HTTPS in front of QE Connect.
QEC_TLS_CERT=
QEC_TLS_KEY=
# Addresses of the reverse proxy, so QE Connect sees real client addresses and HTTPS (comma-separated, e.g. 127.0.0.1).
QEC_TRUSTED_PROXIES=
# Extra host names QE Connect answers to, comma-separated (localhost and the host in QEC_PUBLIC_URL are always allowed).
# Example when colleagues use the computer name: QEC_ALLOWED_HOSTS=laptop-1234,laptop-1234.example.local
QEC_ALLOWED_HOSTS=

# ---- Data ----
# Folder for the SQLite database. Relative paths are inside the QE Connect folder. Back up this folder.
QEC_DATA_DIR=data
# Use PostgreSQL instead of SQLite (start.bat installs the driver when it sees "postgresql" here):
# QEC_DATABASE_URL=postgresql+psycopg://qec:CHANGE-ME@dbserver:5432/qec
QEC_DATABASE_URL=

# ---- Sign-in ----
# Hours before a team member has to sign in again.
QEC_SESSION_HOURS=12
# Sign-in codes (MFA) and the inactivity timeout are set on the Administration page.
# true = cookies are only sent over HTTPS. Turn on when QE Connect is behind HTTPS (automatic when the request is HTTPS).
QEC_SECURE_COOKIES=false

# ---- Email delivery secrets (the rest is set on the Email delivery page) ----
# Microsoft 365 (Graph) app registration client secret:
QEC_MAIL_CLIENT_SECRET=
# Or, for certificate sign-in, the PEM file holding the certificate's private key:
QEC_MAIL_CERT_PATH=
# Password for an SMTP relay that needs sign-in:
QEC_SMTP_PASSWORD=
# false = don't send queued emails from this server (for example on a test copy).
QEC_MAIL_WORKER=true

# ---- Troubleshooting ----
# true = interactive API documentation at /api/docs (leave off in production).
QEC_API_DOCS=false
# debug, info, warning or error
QEC_LOG_LEVEL=info
